<?xml version="1.0" encoding="utf-8" ?>
<!-- One row in the channel and movie list: logo or poster, number or rating, and name. -->
<component name="ChannelItem" extends="Group">
  <interface>
    <field id="itemContent" type="node" onChange="onContent" />
    <field id="width" type="float" value="1180" onChange="onWidth" />
    <field id="height" type="float" value="96" />
  </interface>
  <script type="text/brightscript" uri="ChannelItem.brs" />
  <children>
    <Poster id="logo" translation="[16,8]" width="140" height="80" loadDisplayMode="scaleToFit" />
    <Label id="number" translation="[172,0]" width="110" height="96" vertAlign="center" color="0xD8C4FFFF" font="font:SmallBoldSystemFont" />
    <Label id="name" translation="[290,0]" width="870" height="96" vertAlign="center" color="0xFFFFFFFF" font="font:MediumSystemFont" />
  </children>
</component>

<?xml version="1.0" encoding="utf-8" ?>
<!-- Pair with your phone: asks lumanest.tv for a code, then polls until the customer approves it. -->
<component name="PairTask" extends="Task">
  <interface>
    <field id="cancel" type="boolean" value="false" />
    <field id="userCode" type="string" />
    <field id="qr" type="array" />
    <field id="status" type="string" />
    <field id="account" type="assocarray" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/common/Util.brs" />
  <script type="text/brightscript" uri="PairTask.brs" />
</component>

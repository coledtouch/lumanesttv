sub Main()
    x = pairSource({type: "xtream", server: "https://xtream.lumanest.tv/", username: "u", password: "p"})
    assertEqual(x.server, "https://xtream.lumanest.tv", "paired server normalized")
    assertEqual(x.name, "LumaNest TV", "default name")
    assertEqual(x.password, "p", "paired password")
    assertEqual(pairSource({type: "xtream", server: "xtream.lumanest.tv", username: "u", password: "p"}).server, "http://xtream.lumanest.tv", "bare host gets a scheme")
    assertInvalid(pairSource({type: "xtream", server: "", username: "u"}), "missing server")
    assertInvalid(pairSource({type: "xtream", server: "h", username: ""}), "missing username")
    m3u = pairSource({type: "m3u", name: "Mine", m3uUrl: "https://p/list.m3u"})
    assertEqual(m3u.m3uUrl, "https://p/list.m3u", "paired M3U link")
    assertEqual(m3u.name, "Mine", "paired name")
    assertInvalid(pairSource({type: "m3u", m3uUrl: "ftp://p/list.m3u"}), "non-HTTP playlist")
    assertInvalid(pairSource({type: "other"}), "unknown account type")
    assertInvalid(pairSource(invalid), "no account")
    finish()
end sub

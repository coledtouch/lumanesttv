<?xml version="1.0" encoding="utf-8"?>
<!-- Provider credentials live in shared preferences; keep them on this device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>

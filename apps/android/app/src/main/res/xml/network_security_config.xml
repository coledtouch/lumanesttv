<?xml version="1.0" encoding="utf-8"?>
<!-- Most IPTV panels serve plain http, so cleartext has to be allowed. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- The app's own logo database is HTTPS only. epgshare01 stays out: users may paste its http guide links. -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="false">iptv-org.github.io</domain>
    </domain-config>
</network-security-config>

# Cloudflare static asset headers. The build copies this file to dist/client/_headers; with it present, vinext no
# longer writes its own, so its rule for content-hashed assets is repeated here.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Google Cast receiver (docs/casting.md). Cast devices cache receiver pages aggressively, so the page and its script
# are revalidated on every launch (a quick 304 when unchanged). The page asks for mpegts.js as
# /cast/mpegts.js?v=<version>, so a new version is a new address and the file can be kept for good. Cloudflare joins
# the values of every rule a path matches, so these rules must not overlap (no /cast/* rule).
/cast/receiver
  Cache-Control: no-cache
/cast/receiver.html
  Cache-Control: no-cache
/cast/receiver.js
  Cache-Control: no-cache
/cast/mpegts.js
  Cache-Control: public, max-age=31536000, immutable

# The in-app trailer page's own files (app/embed/trailer/route.ts, lib/trailer-embed.ts). The page asks for them with
# ?v=<hash of the file>, and keeps them for the same day the page itself is kept.
/embed/trailer-frame.js
  Cache-Control: public, max-age=86400
  X-Content-Type-Options: nosniff
/embed/trailer-frame.css
  Cache-Control: public, max-age=86400
  X-Content-Type-Options: nosniff
